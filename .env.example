API_FOOTBALL_KEY=replace_with_your_api_key
PORT=8787

# Optional: proxy reachable from the machine running Node (restart after editing).
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Live scores are shared by all pages and tasks for at least 5 minutes.
# API_FOOTBALL_LIVE_CACHE_SECONDS=300
# Browser refreshes use cached data after the remaining daily quota reaches this reserve.
# Monitoring tasks may still use the reserved requests.
# API_FOOTBALL_QUOTA_RESERVE=10
